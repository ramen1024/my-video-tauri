{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "name": "open-url", "url": "http://**" },
        { "name": "open-url", "url": "https://**" },
        { "name": "open-url", "url": "mailto:**" },
        { "name": "open-url", "url": "tel:**" }
      ]
    },
    "shell:allow-execute"
  ]
}
